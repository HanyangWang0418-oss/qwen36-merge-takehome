# copy to eval/.env and fill in; eval/*.sh source it
VLLM_BASE=https://TUNNEL_HOST.trycloudflare.com/v1     # printed by eval/serve.sh (cloudflared) or your own domain
VLLM_HOST=TUNNEL_HOST.trycloudflare.com                # host only, for --allow-agent-host
OPENAI_API_KEY=dummy                           # vLLM ignores it; agents require it set
OPENAI_JUDGE_KEY=sk-...                        # real OpenAI key, HLE judge (o3-mini) only
ASIBENCH_JUDGE_API_BASE=https://api.openai.com/v1
ASIBENCH_JUDGE_API_KEY=sk-...
ASIBENCH_JUDGE_MODEL=gpt-5-mini               # fixed before training in configs/eval/asi_bench.yaml once chosen
HF_TOKEN=hf_...                                # HLE gated dataset + adapter downloads
MODAL_PROFILE=default
HARBOR_ENV=modal
CONCURRENCY=20                                 # Modal trials in flight
TB_CPUS=32
TB_MEM_MB=49152
